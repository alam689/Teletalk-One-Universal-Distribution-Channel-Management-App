# Base URL of the Teletalk One API gateway.
# Leave empty to run against the in-repo mock (development only).
VITE_API_BASE_URL=

# Request timeout in milliseconds. Field connectivity is poor; do not drop
# this below ~15s or activations will fail on 2G.
VITE_API_TIMEOUT_MS=20000

# Minutes of inactivity before the session is ended and the user is returned
# to sign-in. Retailer terminals are shared counters — keep this short.
VITE_IDLE_TIMEOUT_MIN=15
